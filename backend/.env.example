# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================

# Supabase PostgreSQL (Transaction Pooler - Porta 6543)
# Utilizado pela aplicação em runtime para queries otimizadas
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[SENHA-DO-BANCO]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (Session Pooler - Porta 5432)
# Utilizado exclusivamente pelo Prisma para migrations (prisma migrate deploy) e compatibilidade IPv4
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[SENHA-DO-BANCO]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Porta do servidor (Render injeta automaticamente a variável PORT)
PORT=3000
PORT_SERVER=3000

# Chave secreta para assinatura dos tokens JWT (gere um hash seguro aleatório de 64 caracteres)
TOKEN_SECRET="substitua_por_uma_chave_secreta_longa_e_aleatoria"

# Origem permitida para requisições CORS (em desenvolvimento: http://localhost:5173; em produção: sua URL do Cloudflare Pages)
CORS_ORIGIN="http://localhost:5173"
